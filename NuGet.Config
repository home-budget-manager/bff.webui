<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="HomeBudgetManager" value="https://nuget.pkg.github.com/home-budget-manager/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="HomeBudgetManager">
      <package pattern="HomeBudgetManager.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
